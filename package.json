{
  "name": "mine-qubic",
  "productName": "Mine Qubic",
  "version": "0.2.3",
  "description": "Un clic et ton PC mine du QUBIC sur le pool qubic.li (non-custodial).",
  "main": "src/main.js",
  "author": "Cointribune",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test/run.js",
    "build:win": "electron-builder --win --config electron-builder.config.js",
    "build:linux": "electron-builder --linux AppImage --config electron-builder.config.js",
    "icon": "python3 scripts/make_icon.py",
    "test:ui": "node test/ui.js",
    "test:all": "npm test && npm run test:ui"
  },
  "dependencies": {
    "@qubic-lib/qubic-ts-library": "^0.1.6",
    "adm-zip": "^0.5.16",
    "electron-updater": "^6.8.9",
    "qrcode": "^1.5.4",
    "tar": "^7.4.3"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3"
  }
}
